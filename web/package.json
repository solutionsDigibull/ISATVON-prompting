{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "predev": "npm run content",
    "prebuild": "npm run content",
    "content": "tsx scripts/build-content.ts",
    "content:check": "tsx scripts/build-content.ts --check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "format": "cd .. && prettier --write .",
    "format:check": "cd .. && prettier --check .",
    "lint:md": "cd .. && markdownlint-cli2",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "prepare": "cd .. && husky .husky"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "canvas-confetti": "^1.9.4",
    "motion": "^13.1.1",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.3.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.19"
  }
}
